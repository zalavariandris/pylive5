        "name": "<script>",
        "source": "from vfxops.io import read_image\nfrom vfxops.draw import gradient\nfrom vfxops.color import grade\nfrom vfxops.filter import gaussian_blur\nfrom vfxops.file_sequence import FileSequence\nfrom vfxops.merge import merge_over\nimport pathlib\n\n\ndef read_video(path: pathlib.Path):\n    seq = FileSequence.from_single_frame(path)\n    def wrapped(frame:int):\n        frame_path = seq.get_path(frame)\n        return read_image(frame_path)\n    return wrapped\n    \ndef blur_video(video, size:float=0.0):\n    def wrapped(frame:int):\n        img = video(frame)\n        return gaussian_blur(img, size)\n    return wrapped\n    \ndef merge_video(A, B, mix:float=0.5):\n    def wrapper(frame:int):\n        img_A = A(frame)\n        img_B = B(frame)\n        return merge_over(img_A, img_B, mix)\n    return wrapper\n    \ndef time_offset(video, offset:int=0):\n    def wrapper(frame:int):\n        return video(frame+offset)\n    return wrapper\n    \ndef get_image_frame(video, frame:int=0):\n    return video(frame)\n    \n__all__ = [\n    'read_video',\n    'blur_video',\n    'merge_video',\n    'time_offset',\n    'get_image_frame',\n    'read_image',\n    'grade',\n    'gradient',\n    'gaussian_blur'\n]"
