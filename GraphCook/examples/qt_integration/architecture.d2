vars: {
    d2-config: {
        layout-engine: elk
    }
}
direction: right

Backend {
    Engine {
        shape: class
        graph
    }
}


FRONTEND {
    QDomainModel{
        shape: class
    }
}

Contract {
    graph {
        ReadableGraph{
            shape: class
            + nodes
            + attributes
            + in_links
            + out_links
            + links
        }
        MutableGraph {
            shape: class
            add_node
            remove_node
            add_link
            remove_link
            set
            unset
        }
        GraphChange {
            shape: class
        }
    }

    provider {
        operators
        added
        removed
    }
}

Backend.Engine.graph -> Contract.graph.ReadableGraph
Backend.Engine.graph -> Contract.graph.MutableGraph

Backend.Engine.listen -> Contract.graph.GraphChange: 🔔


Contract.graph.ReadableGraph -> FRONTEND.QDomainModel:  📖
Contract.graph.MutableGraph <- FRONTEND.QDomainModel:  ✏️
Contract.graph.GraphChange -> FRONTEND.QDomainModel:  👂





